#!/bin/bash
# Shared environment variables for both bash and zsh
# This file is sourced by both ~/.bashrc and ~/.zshrc

# Load global environment variables (tracked by chezmoi)
if [ -f "$HOME/.env/global" ]; then
  source "$HOME/.env/global"
fi

# Load global environment variables (tracked by chezmoi)
if [ -f "$HOME/.env/aliases" ]; then
  source "$HOME/.env/aliases"
fi

# Load secrets (not tracked by chezmoi)
if [ -f "$HOME/.env/secrets" ]; then
  source "$HOME/.env/secrets"
fi

