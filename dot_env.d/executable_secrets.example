#!/bin/bash
# Secret environment variables template
# Copy this file to 'secrets' (without .example) and add your actual secrets
# The 'secrets' file is ignored by chezmoi and git

# API Keys
# export GITHUB_TOKEN="your-github-token-here"
# export OPENAI_API_KEY="your-openai-api-key"
# export AWS_ACCESS_KEY_ID="your-aws-access-key"
# export AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# Database credentials
# export DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
# export REDIS_PASSWORD="your-redis-password"

# Authentication tokens
# export JWT_SECRET="your-jwt-secret"
# export OAUTH_CLIENT_SECRET="your-oauth-client-secret"

# Other secrets
# export ENCRYPTION_KEY="your-encryption-key"
# export WEBHOOK_SECRET="your-webhook-secret"

# Instructions:
# 1. Copy this file: cp ~/.env/secrets.example ~/.env/secrets
# 2. Uncomment and fill in your actual secret values
# 3. The secrets file is automatically ignored by chezmoi